# Set strong unique values before starting the stack. Do not commit .env.
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=replace_with_a_long_random_postgres_password
POSTGRES_DB=ai_video_db

MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=replace_with_a_long_random_minio_password

# ComfyUI must be running and reachable by the worker container.
COMFYUI_URL=http://host.docker.internal:8188
COMFYUI_TIMEOUT_SECONDS=1800
COMFYUI_POLL_SECONDS=3

# URL embedded in presigned object URLs and opened by the user's browser.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=ai-videos
CORS_ORIGINS=http://localhost:3005
NEXT_PUBLIC_API_URL=http://localhost:8005
